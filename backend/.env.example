PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Odyssey site origin (local Next.js or production URL)
FRONTEND_URL=http://localhost:3000

# Public gate QR check-in passcode (organizers only — not in the QR)
GATE_CHECKIN_CODE=RAAMTECH

# Secret the judges type to unlock the official 24-hour start.
# Set this on Render only. Do not reuse GATE_CHECKIN_CODE.
# Never put this value in a NEXT_PUBLIC_ variable.
JURY_ACCESS_CODE=

# Admin auth (no plaintext password — store a bcrypt hash only)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Payment screenshot storage (Supabase free tier)
# Create private bucket "payment-proofs" in Supabase Storage, or run
# database/migrations/add_payment_supabase_storage.sql
# Backend can also auto-create the bucket on first upload via service role.
PAYMENT_STORAGE_BUCKET=payment-proofs
